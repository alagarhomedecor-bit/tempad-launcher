<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0704"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.15"
        android:text="TVA // TEMPAD TERMINAL"
        android:textColor="#E08B2A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTimeline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="SACRED TIMELINE // STABLE"
        android:textColor="#7A4B13"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:layout_weight="1"
        android:background="#120D07"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="16dp"
        android:text="TEMPAD ONLINE\nSYSTEM MONITORED\nREADY FOR RESET CHARGE"
        android:textColor="#F3A63B"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnDoor"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E08B2A"
        android:text="INITIALIZE TIMEDOOR"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
